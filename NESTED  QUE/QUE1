CREATE TABLE employee (
    eid INT PRIMARY KEY,
    ename VARCHAR(100),
    age INT,
    salary DECIMAL(10),
    bname VARCHAR(100)
);

CREATE TABLE branch (
    bname VARCHAR(100) PRIMARY KEY,
    yoe INT
);
